{% comment %}
  {% stylesheet %} ではなく {% style %} を使用する（sections/ranking-list.liquid,
  sections/brand-list.liquidで判明した、Horizonのコンパイル済みCSSバンドルに{% stylesheet %}
  が含まれないことがある既知の不具合を避けるため）。このセクションは1ページに1つのみ配置する
  前提のため、{% stylesheet %}のような自動スコープが無くても実害はない。
{% endcomment %}
{% style %}
  .category-list-page {
    display: flex;
    flex-direction: column;
    gap: 32px;
    padding-block: 32px;
  }

  .category-list-page__heading {
    margin: 0;
  }

  .category-list__groups {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 28px;
    align-items: start;
  }

  .category-group {
    border: 1px solid rgb(var(--color-foreground-rgb) / var(--opacity-10, 0.1));
    border-radius: 10px;
    padding: 20px 22px 24px;
    background: rgb(var(--color-background-rgb) / 1);
  }

  .category-group--flat {
    padding-block: 16px 18px;
  }

  .category-group__title {
    margin: 0 0 12px;
    padding-bottom: 10px;
    border-bottom: 2px solid #c9a227;
    font-size: 1.15rem;
  }

  .category-group__title a {
    color: inherit;
    text-decoration: none;
  }

  .category-group__title a:hover {
    color: #c9a227;
  }

  .category-group__level2 {
    display: flex;
    flex-direction: column;
    gap: 10px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .category-group__level2 > li > a {
    display: inline-block;
    font-weight: var(--font-heading-bold--weight, 700);
    font-size: 0.98rem;
    color: inherit;
    text-decoration: none;
  }

  .category-group__level2 > li > a:hover {
    color: #c9a227;
  }

  .category-group__level3 {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 14px;
    margin: 6px 0 0;
    padding: 0 0 0 14px;
    list-style: none;
    border-left: 1px solid rgb(var(--color-foreground-rgb) / var(--opacity-15, 0.15));
  }

  .category-group__level3 > li {
    font-size: 0.85rem;
  }

  .category-group__level3 > li > a {
    color: rgb(var(--color-foreground-rgb) / var(--opacity-80, 0.8));
    text-decoration: none;
  }

  .category-group__level3 > li > a::before {
    content: '- ';
  }

  .category-group__level3 > li > a:hover {
    color: #c9a227;
  }
{% endstyle %}

{% schema %}
{
  "name": "カテゴリ一覧",
  "enabled_on": {
    "templates": ["page"]
  },
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "見出し",
      "default": "カテゴリ一覧"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:settings.color_scheme",
      "default": "scheme-1"
    }
  ],
  "presets": [
    {
      "name": "カテゴリ一覧"
    }
  ]
}
{% endschema %}
