    <div class="guide-beginner-info">
      <h3>初めての方へ</h3>
      <p>コスメティックタイムズとはどんなショップなのかご案内いたします。</p>
      <ul>
        <li><a href="/pages/guide-info#info01">コスメティックタイムズとは？</a></li>
        <li><a href="/pages/guide-info#info02">コスメティックタイムズの3つのお約束</a></li>
        <li><a href="/pages/guide-info#info03">選ばれる理由</a></li>
      </ul>
    </div>
  </div>
</div>

{% style %}
  .guide-list {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
    gap: 24px;
    margin-bottom: 32px;
  }

  .guide-list-col h3 {
    margin: 0 0 10px;
    padding-bottom: 6px;
    border-bottom: 1px solid rgb(var(--color-foreground-rgb) / var(--opacity-20, 0.2));
  }

  .guide-list-col ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .guide-list-col li {
    margin-bottom: 8px;
  }

  .guide-beginner-info {
    padding: 20px;
    background: rgb(var(--color-foreground-rgb) / var(--opacity-5, 0.05));
    border-radius: 8px;
  }

  .guide-beginner-info h3 {
    margin-top: 0;
  }
{% endstyle %}

{% schema %}
{
  "name": "ご利用ガイド トップ",
  "enabled_on": {
    "templates": ["page"]
  },
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "見出し",
      "default": "ご利用ガイド"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:settings.color_scheme",
      "default": "scheme-1"
    }
  ],
  "presets": [
    {
      "name": "ご利用ガイド トップ"
    }
  ]
}
{% endschema %}
