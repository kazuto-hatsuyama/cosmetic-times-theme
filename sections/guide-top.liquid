{% style %}
  .guide-list {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
    gap: 24px;
    margin-bottom: 32px;
  }

  .guide-list-col h3 {
    margin: 0 0 10px;
    padding-bottom: 6px;
    border-bottom: 1px solid rgb(var(--color-foreground-rgb) / var(--opacity-20, 0.2));
  }

  .guide-list-col ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .guide-list-col li {
    margin-bottom: 8px;
  }

  .guide-beginner-info.static-page__callout h3 {
    margin-top: 0;
    border-bottom: none;
    padding-left: 0;
    border-left: none;
    color: #c83564;
  }

  .guide-contact {
    display: flex;
    flex-direction: column;
    gap: 12px;
    margin-bottom: 8px;
  }

  .guide-contact__tel {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 16px 20px;
    background-color: #c83564;
    color: #fff;
    border-radius: 10px;
    font-weight: 700;
    font-size: 1.1rem;
    text-decoration: none;
  }

  .guide-contact__tel:hover {
    background-color: #a8284f;
    color: #fff;
    text-decoration: none;
  }

  .guide-contact__icon {
    font-size: 1.2rem;
  }
{% endstyle %}

{% schema %}
{
  "name": "ご利用ガイド トップ",
  "enabled_on": {
    "templates": ["page"]
  },
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "見出し",
      "default": "ご利用ガイド"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:settings.color_scheme",
      "default": "scheme-1"
    }
  ],
  "presets": [
    {
      "name": "ご利用ガイド トップ"
    }
  ]
}
{% endschema %}
