{% liquid
  # collection経由URL（/collections/{handle}/products/{handle}）はストア側の
  # リダイレクト設定により常に/products/{handle}へ正規化されてしまい、
  # collectionオブジェクトが渡らないため、商品が所属するコレクションから
  # 代表コレクションをフォールバックとして選ぶ
  assign breadcrumb_collection = collection
  if breadcrumb_collection == blank
    for c in product.collections
      unless c.handle == 'all'
        assign breadcrumb_collection = c
        break
      endunless
    endfor
  endif
%}

<div class="section-background color-{{ section.settings.color_scheme }}"></div>
<nav class="breadcrumbs color-{{ section.settings.color_scheme }} page-width" aria-label="breadcrumb">
  <ol class="breadcrumbs__list">
    <li class="breadcrumbs__item">
      <a class="breadcrumbs__link" href="{{ routes.root_url }}">ホーム</a>
    </li>
    {% if breadcrumb_collection %}
      <li class="breadcrumbs__item">
        <a class="breadcrumbs__link" href="{{ breadcrumb_collection.url }}">{{ breadcrumb_collection.title }}</a>
      </li>
    {% endif %}
    <li class="breadcrumbs__item">
      <span class="breadcrumbs__current" aria-current="page">{{ product.title }}</span>
    </li>
  </ol>
</nav>

{% stylesheet %}
  .breadcrumbs {
    padding-block: 12px;
  }

  .breadcrumbs__list {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .breadcrumbs__item {
    display: flex;
    align-items: center;
    font-size: 1.2rem;
    letter-spacing: 0.03em;
    color: rgb(var(--color-foreground-rgb) / var(--opacity-70, 0.7));
  }

  .breadcrumbs__item:not(:last-child)::after {
    content: '/';
    margin-inline: 0.6em;
    color: rgb(var(--color-foreground-rgb) / var(--opacity-40, 0.4));
  }

  .breadcrumbs__link {
    color: inherit;
    text-decoration: none;

    &:hover {
      text-decoration: underline;
    }
  }

  .breadcrumbs__current {
    color: var(--color-foreground);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "パンくずリスト",
  "enabled_on": {
    "templates": ["product"]
  },
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:settings.color_scheme",
      "default": "scheme-1"
    }
  ],
  "presets": [
    {
      "name": "パンくずリスト"
    }
  ]
}
{% endschema %}
