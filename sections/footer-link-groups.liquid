      "id": "color_scheme",
      "label": "t:settings.color_scheme",
      "default": "scheme-8"
    }
  ],
  "presets": [
    {
      "name": "フッターリンクグループ",
      "category": "t:categories.footer"
    }
  ]
}
{% endschema %}
