  {% stylesheet %} ではなく {% style %} を使用する（sections/category-list.liquidと同じ理由。
  sections/ranking-list.liquid, sections/brand-list.liquidで判明した既知の不具合を避けるため）。
{% endcomment %}
{% style %}
  .trouble-list-page {
    display: flex;
    flex-direction: column;
    gap: 32px;
    padding-block: 32px;
  }

  .trouble-list-page__heading {
    margin: 0;
  }

  .trouble-list__groups {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 28px;
    align-items: start;
  }

  .trouble-group {
    border: 1px solid rgb(var(--color-foreground-rgb) / var(--opacity-10, 0.1));
    border-radius: 10px;
    padding: 20px 22px 24px;
    background: rgb(var(--color-background-rgb) / 1);
  }

  .trouble-group__title {
    margin: 0 0 14px;
    padding-bottom: 10px;
    border-bottom: 2px solid #c9a227;
    font-size: 1.15rem;
  }

  .trouble-group__items {
    display: flex;
    flex-direction: column;
    gap: 10px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .trouble-group__items > li > a {
    display: inline-block;
    font-size: 0.95rem;
    color: inherit;
    text-decoration: none;
  }

  .trouble-group__items > li > a::before {
    content: '- ';
    color: #c9a227;
  }

  .trouble-group__items > li > a:hover {
    color: #c9a227;
  }
{% endstyle %}

{% schema %}
{
  "name": "お悩み一覧",
  "enabled_on": {
    "templates": ["page"]
  },
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "見出し",
      "default": "お悩み一覧"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:settings.color_scheme",
      "default": "scheme-1"
    }
  ],
  "presets": [
    {
      "name": "お悩み一覧"
    }
  ]
}
{% endschema %}
