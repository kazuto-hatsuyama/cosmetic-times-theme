{%- doc -%}
  This snippet is used to render a product card.
  It is used in the product block,featured product block, and the product card block.

  @param {product} product_resource - The product to render
  @param {boolean} [show_unit_price] - Whether to show the unit price
  @param {boolean} [show_sale_price_first] - Whether to show the sale price first
{%- enddoc -%}

{%- liquid
  assign show_unit_price = show_unit_price | default: false
  assign show_sale_price_first = show_sale_price_first | default: false
  assign selected_variant = product_resource.selected_or_first_available_variant
  assign price = selected_variant.price
  assign price_raw = selected_variant.price
  assign compare_at_price = selected_variant.compare_at_price

  assign show_compare_price = false
  if compare_at_price > price
    assign show_compare_price = true
  endif

  # 割引率バッジ（◯◯％OFF!）用。フォーマット前の生の値（cents相当）で計算する。
  # compare_at_price/price はこの後 money/money_with_currency フィルタで文字列化されるため、
  # その前に price_raw と同様の生の数値を確保しておく
  assign compare_at_price_raw = selected_variant.compare_at_price
  assign discount_percent = null
  if show_compare_price and compare_at_price_raw > 0
    assign discount_percent = compare_at_price_raw | minus: price_raw | times: 100.0 | divided_by: compare_at_price_raw | floor
  endif

  if product_resource == blank
    assign price = 1999
  endif

  # Check if variant has volume pricing
  assign has_volume_pricing = null
  assign price_min = null
  assign price_max = null

  # For product cards (collection/search pages), calculate min/max across all variants
  # For product pages, only use the selected variant's pricing
  assign is_product_card = false
  if template.name != 'product'
    assign is_product_card = true
  endif

  if is_product_card
    assign price_min = product_resource.price_min
    assign price_max = product_resource.price_max
    assign has_volume_pricing = product_resource.quantity_price_breaks_configured? | default: false
  else
    # Product page: only use selected variant's pricing
    if selected_variant.quantity_price_breaks.size > 0
      assign has_volume_pricing = true
      assign price_min = selected_variant.quantity_price_breaks.last.price
      assign price_max = selected_variant.price
    endif
  endif

  # 獲得予定ポイント（商品詳細ページのみ・商品カードでは表示しない）
  # 還元率: ログイン中は customer.metafields.custom.point_rate、未設定/未ログインは
  # shop.metafields.custom.default_point_rate にフォールバック（sync_member.cfmのpoint_rate_syncステップが同期）
  assign expected_points = null
  if is_product_card == false and price_raw != blank
    assign expected_point_rate = shop.metafields.custom.default_point_rate.value
    if customer
      assign customer_point_rate = customer.metafields.custom.point_rate.value
      if customer_point_rate != blank
        assign expected_point_rate = customer_point_rate
      endif
    endif
    if expected_point_rate != blank
      # price_raw はcents相当（JPYは小数点なしのため常に100の倍数）なので割って実額(円)に戻す
      assign price_yen = price_raw | divided_by: 100
      assign expected_points = price_yen | times: expected_point_rate | divided_by: 100.0 | floor
    endif
  endif

  # リピート人数（商品詳細ページの本体表示のみ・商品カードでは表示しない）
  # DM_UnitItemMartDT.RepeatCnt をShopify側で反映したバリアントメタフィールド。
  # 0/未設定は「非表示」の判定をテーマ側で行う運用（データ側は常に値をセットする）
  # is_product_card は template.name のみで判定しているため、商品詳細ページ内の
  # おすすめ商品カード（resource-card.liquid経由・別商品）では false のまま漏れて
  # しまう。ここでは「表示中の商品詳細ページ自身」であることまで厳密に判定する
  assign repeat_count = null
  if template.name == 'product' and product.handle == product_resource.handle
    assign repeat_count = selected_variant.metafields.custom.repeat_count.value
  endif

  # Determine if currency code should be shown
  assign use_currency = false
  if product.handle == product_resource.handle
    if settings.currency_code_enabled_product_pages
      assign use_currency = true
    endif
  elsif settings.currency_code_enabled_product_cards
    assign use_currency = true
  endif

  # Format all prices
  if use_currency
    assign price = price | money_with_currency
    assign compare_at_price = compare_at_price | money_with_currency
    assign price_min = price_min | money_with_currency
    assign price_max = price_max | money_with_currency
  else
    assign price = price | money
    assign compare_at_price = compare_at_price | money
    assign price_min = price_min | money
    assign price_max = price_max | money
  endif
-%}

<div ref="priceContainer">
  {% if has_volume_pricing %}
    {% comment %} Volume pricing display {% endcomment %}
    {% if show_compare_price %}
      <span class="price-item__group">
        <span class="visually-hidden">{{ 'content.price_regular' | t }}&nbsp;</span>
        <span class="compare-at-price">{{- compare_at_price -}}</span>
      </span>
    {% endif %}
    <span class="price-item__group">
      <span class="visually-hidden">{{ 'content.price_range' | t }}&nbsp;</span>
      <span class="price">{{ price_min }} - {{ price_max }}</span>
    </span>
  {% else %}
    {% comment %} Standard pricing display {% endcomment %}
    <div
      class="
        price__regular
        {% if show_compare_price %}
          price__hidden
        {% endif %}
      "
    >
      <span class="price">{{ price | default: '&nbsp;' }}</span>
    </div>
    <div
      class="
        price__sale
        {% unless show_compare_price %}
          price__hidden
        {% endunless %}
      "
    >
      {% if show_sale_price_first %}
        <span class="price-item__group">
          <span class="visually-hidden">{{ 'content.price_sale' | t }}&nbsp;</span>
          <span class="price-item--sale price">{{ price | default: '&nbsp;' }}</span>
          {%- if discount_percent != null -%}
            <span class="discount-badge">{{ discount_percent }}％OFF!</span>
          {%- endif -%}
        </span>
        <span class="price-item__group">
          <span class="visually-hidden">{{ 'content.price_regular' | t }}&nbsp;</span>
          <span class="price-item--regular compare-at-price">{{- compare_at_price -}}</span>
        </span>
      {% else %}
        <span class="price-item__group">
          <span class="visually-hidden">{{ 'content.price_regular' | t }}&nbsp;</span>
          <span class="price-item--regular compare-at-price">{{- compare_at_price -}}</span>
        </span>
        <span class="price-item__group">
          <span class="visually-hidden">{{ 'content.price_sale' | t }}&nbsp;</span>
          <span class="price-item--sale price">{{ price | default: '&nbsp;' }}</span>
          {%- if discount_percent != null -%}
            <span class="discount-badge">{{ discount_percent }}％OFF!</span>
          {%- endif -%}
        </span>
      {% endif %}
    </div>
  {% endif %}
  {%- if expected_points != null -%}
    <div class="expected-points">
      {%- if customer -%}
        <span class="expected-points__label">獲得予定ポイント：</span><span class="expected-points__value">{{ expected_points }}pt</span>
      {%- else -%}
        <span class="expected-points__label">会員登録で</span><span class="expected-points__value">{{ expected_points }}pt</span><span class="expected-points__label">獲得</span>
      {%- endif -%}
    </div>
  {%- endif -%}
  {%- if repeat_count != blank and repeat_count != 0 -%}
    <div class="repeat-count">
      <span class="repeat-count__value">現在{{ repeat_count }}人のCTメンバーがリピートしています</span>
    </div>
  {%- endif -%}
  {%- if selected_variant.unit_price and show_unit_price %}
    {%- liquid
      if use_currency
        assign unit_price = selected_variant.unit_price | money_with_currency
      else
        assign unit_price = selected_variant.unit_price | money
      endif
    -%}
    {% render 'unit-price', price: unit_price, measurement: selected_variant.unit_price_measurement %}
  {%- endif -%}
</div>
{%- if has_volume_pricing -%}
  <small
    ref="volumePricingNote"
    class="volume-pricing-note"
  >
    {{- 'content.volume_pricing_available' | t -}}
  </small>
{%- endif -%}

{% style %}
  .discount-badge {
    display: inline-block;
    margin-left: 0.5em;
    padding: 0.15em 0.6em;
    background-color: #9B2226;
    color: #ffffff;
    font-size: 0.78em;
    font-weight: 700;
    line-height: 1.4;
    letter-spacing: 0.02em;
    border-radius: 3px;
    vertical-align: middle;
    white-space: nowrap;
  }

  .expected-points {
    margin-top: 0.35em;
    font-size: min(0.85em, var(--font-paragraph--size));
    font-weight: var(--font-paragraph--weight);
    color: rgb(var(--color-foreground-rgb) / var(--opacity-subdued-text));
  }

  .expected-points__value {
    font-weight: 600;
    color: var(--color-foreground);
  }

  .repeat-count {
    margin-top: 0.35em;
    font-size: min(0.85em, var(--font-paragraph--size));
    font-weight: var(--font-paragraph--weight);
    color: rgb(var(--color-foreground-rgb) / var(--opacity-subdued-text));
  }

  .repeat-count__value {
    font-weight: 600;
    color: var(--color-foreground);
  }
{% endstyle %}
